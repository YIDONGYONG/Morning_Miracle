<div class="container">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <h1><%= t(".title") %></h1>
      <%= form_with url: login_path do |f| %>
        <div class="mb-3">
          <%= f.label :email, t("helpers.label.email"), class: "form-label" %>
          <%= f.email_field :email, class: "form-control", value: params[:email] %>
        </div>
        <div class="mb-3">
          <%= f.label :password, t("helpers.label.password"), class: "form-label" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>
        <%= f.submit t(".login"), class: "btn btn-primary" %>
      <% end %>
      <div class="text-center mt-3">
        <%= link_to t(".to_register_page"), new_user_path %>
        <%= link_to t(".password_forget"), "#" %>
      </div>
    </div>
  </div>
</div>
