<div id="<%= dom_id vision %>" style="border: 1px solid #ddd; padding: 10px; margin-bottom: 10px;">
  <h3><%= link_to vision.title, vision %></h3>
  <p><%= vision.content %></p>
  
  <div>
    <%= link_to "보기", vision %> |
    <%= link_to "수정", edit_vision_path(vision) %> |
    <%= link_to "삭제", vision_path(vision), data: { turbo_method: :delete, turbo_confirm: "삭제하시겠습니까?" } %>
  </div>
</div>