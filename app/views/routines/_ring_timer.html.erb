<%# 円形のリングタイマー（kind: :timer）。動きは ring_timer_controller.js。locals: routine, seconds
    状態: 待機(空のリング + はじめる) → 進行中(リングが時計回りに満ちる) → 完了(セージ色 + できました) %>
<% pauseable = local_assigns.fetch(:pauseable, seconds >= 300) %>
<div class="mt-4 flex flex-col items-center gap-3 text-center"
     data-controller="ring-timer"
     data-ring-timer-seconds-value="<%= seconds %>"
     data-ring-timer-pauseable-value="<%= pauseable %>"
     data-ring-timer-activity-key-value="<%= routine.category %>"
     data-ring-timer-label-value="<%= routine.category_label %>"
     data-ring-timer-anchor-value="<%= dom_id(routine) %>">

  <div class="ring" data-ring-timer-target="face">
    <svg viewBox="0 0 120 120" class="size-full" aria-hidden="true">
      <circle class="ring-track" cx="60" cy="60" r="54"/>
      <circle class="ring-progress" cx="60" cy="60" r="54" data-ring-timer-target="ring"/>
    </svg>
    <div class="ring-label">
      <span class="text-4xl font-bold text-ink tabular-nums" data-ring-timer-target="remaining"><%= seconds < 60 ? seconds : format("%d:%02d", seconds / 60, seconds % 60) %></span>
      <span class="text-xs text-ink-muted"><span data-ring-timer-target="percent">0</span>%</span>
    </div>
  </div>

  <%# 読み上げは「はじまり」と「完了」のときだけ（残り時間そのものは読み上げない） %>
  <p class="min-h-6 text-sm font-bold text-sage-deep" aria-live="polite" data-ring-timer-target="status"></p>

  <div class="flex w-full flex-col gap-2">
    <button type="button" class="btn btn-primary btn-lg" data-ring-timer-target="startButton" data-action="ring-timer#start">はじめる</button>
    <% if pauseable %>
      <button type="button" class="btn btn-secondary hidden" data-ring-timer-target="pauseButton" data-action="ring-timer#togglePause">一時停止</button>
    <% end %>
    <button type="button" class="btn btn-secondary hidden" data-ring-timer-target="stopButton" data-action="ring-timer#stop">ここまででOK</button>
    <%# 送ったのに記録されなかったとき(通信の失敗など)だけ表示される。タイマーの結果は消えない %>
    <button type="button" class="btn btn-secondary hidden" data-ring-timer-target="retryButton" data-action="ring-timer#retry">もう一度送る</button>
  </div>

  <%# 完了・中断時にこのフォームを Turbo で送る（CSRF トークンは form_with が入れる）。送る値は開始時刻と「できた秒数」だけで、サーバー側で検証する %>
  <%= form_with url: activity_logs_path, scope: :activity_log, class: "hidden", data: { ring_timer_target: "form" } do |f| %>
    <%= f.hidden_field :activity_key, value: routine.category %>
    <%= f.hidden_field :started_at, data: { ring_timer_target: "startedAt" } %>
    <%= f.hidden_field :actual_seconds, data: { ring_timer_target: "actualSeconds" } %>
  <% end %>
</div>
