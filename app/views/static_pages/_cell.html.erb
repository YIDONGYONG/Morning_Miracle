<%# 庭の1マス。state: grown(stage 1-3) / rest(休んだ日) / today / empty。芽は積み上げるほど育ち、枯れない %>
<% label = cell.date.strftime("%-m月%-d日") %>
<% case cell.state %>
<% when :grown %>
  <div class="cell cell-grown" title="<%= label %>">
    <svg viewBox="0 0 40 40" role="img" aria-label="<%= label %> 朝を迎えた日">
      <ellipse cx="20" cy="31" rx="9" ry="3" fill="#d9cbb6"/>
      <% case cell.stage %>
      <% when 1 %>
        <path d="M20 30V24" stroke="#6e9470" stroke-width="2.4" stroke-linecap="round"/><path d="M20 24C20 20 24 19 27 20C27 23.5 24 24.5 20 24Z" fill="#9dbb98"/>
      <% when 2 %>
        <path d="M20 30V19" stroke="#6e9470" stroke-width="2.4" stroke-linecap="round"/><path d="M20 21C20 17 24 16 28 17C28 21 24 22 20 21Z" fill="#9dbb98"/><path d="M20 26C20 22.5 16 21.5 12.5 22.5C12.5 26 16 27 20 26Z" fill="#84a980"/>
      <% else %>
        <path d="M20 30V13" stroke="#6e9470" stroke-width="2.4" stroke-linecap="round"/><path d="M20 24C20 20 24 19 28 20C28 24 24 25 20 24Z" fill="#9dbb98"/><path d="M20 20C20 16.5 16 15.5 12.5 16.5C12.5 20 16 21 20 20Z" fill="#84a980"/><circle cx="20" cy="11" r="3.4" fill="#f2b95f"/>
      <% end %>
    </svg>
  </div>
<% when :rest %>
  <div class="cell cell-rest" title="<%= label %>">
    <svg viewBox="0 0 40 40" role="img" aria-label="<%= label %> 休んだ日"><path d="M11 26h18a4.5 4.5 0 000-9 5.5 5.5 0 00-10.4-1.2A5 5 0 0011 26z" fill="#d8cbba"/></svg>
  </div>
<% when :today %>
  <div class="cell cell-today" title="今日">
    <svg viewBox="0 0 40 40" role="img" aria-label="今日"><circle cx="20" cy="22" r="7" fill="#f6c27e"/><path d="M8 30h24" stroke="#e8b77a" stroke-width="2.4" stroke-linecap="round"/></svg>
  </div>
<% else %>
  <div class="cell cell-empty" aria-hidden="true"></div>
<% end %>
