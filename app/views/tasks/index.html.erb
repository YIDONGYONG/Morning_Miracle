<div class="min-h-screen bg-slate-50 font-sans text-slate-900 pb-20 selection:bg-slate-200" data-controller="tasks">
  <div class="max-w-md mx-auto relative min-h-screen shadow-sm bg-slate-50 overflow-hidden">
    
    <%# 1. Header %>
    <header class="sticky top-0 z-50 bg-slate-50/90 backdrop-blur-xl px-6 pt-12 pb-4 flex items-center justify-between">
      <h1 class="text-xl font-medium tracking-tight text-slate-900">Tasks</h1>
      <div class="flex items-center gap-4 text-slate-500">
        <button type="button" aria-label="Search" class="hover:text-slate-900 transition-colors">
          <%= lucide_icon "search", class: "w-5 h-5 stroke-2" %>
        </button>
        <button type="button" aria-label="Notifications" class="hover:text-slate-900 transition-colors">
          <%= lucide_icon "bell", class: "w-5 h-5 stroke-2" %>
        </button>
        <button type="button" aria-label="Profile" class="w-8 h-8 rounded-full bg-slate-900 flex items-center justify-center text-white hover:bg-slate-800 transition-colors">
          <%= lucide_icon "user", class: "w-4 h-4 stroke-[2.5]" %>
        </button>
      </div>
    </header>

    <main class="px-5 mt-2 space-y-7">
      
      <%# 2. Date & Title %>
      <section class="flex items-end justify-between">
        <div>
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-1">
            <%= Date.today.strftime("%A, %b %d") %>
          </span>
          <h2 class="text-3xl leading-none text-slate-900 tracking-tight font-medium">
            Daily Focus
          </h2>
        </div>
        <div class="flex items-center gap-2 bg-slate-200/60 px-3 py-1.5 rounded-full">
          <span class="w-2 h-2 rounded-full bg-slate-900 animate-pulse"></span>
          <span class="text-xs font-semibold text-slate-700 tracking-wide">3 active</span>
        </div>
      </section>

      <%# 3. Trajectory Card (Progress) %>
      <section class="bg-white rounded-[1.25rem] p-6 shadow-sm border border-slate-100/60">
        <div class="flex items-start justify-between">
          <div class="space-y-1">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Today's Trajectory</span>
            <div class="flex items-baseline gap-2 pt-1">
              <span class="text-3xl leading-none text-slate-900 font-semibold">4 of 7</span>
              <span class="text-sm text-slate-500 font-medium">completed</span>
            </div>
          </div>
          
          <div class="relative w-14 h-14 flex items-center justify-center">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 36 36">
              <path class="text-slate-100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3"></path>
              <path class="text-slate-900" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-dasharray="57, 100" stroke-linecap="round" stroke-width="3.2"></path>
            </svg>
            <span class="absolute text-xs font-bold text-slate-900">57%</span>
          </div>
        </div>
        
        <div class="mt-6 pt-5 border-t border-slate-50 flex items-center justify-between text-slate-500">
          <div class="flex items-center gap-2">
            <%= lucide_icon "timer", class: "w-4 h-4" %>
            <span class="text-sm font-medium">3h 40m focused</span>
          </div>
          <div class="flex items-center gap-2">
            <%= lucide_icon "zap", class: "w-4 h-4" %>
            <span class="text-sm font-medium">Deep work on track</span>
          </div>
        </div>
      </section>

      <%# 4. Add Task Input (Turbo Frame Target) %>
      <turbo-frame id="new_task">
        <%= form_with url: tasks_path, class: "bg-white rounded-2xl p-2 pl-4 flex items-center shadow-sm border border-slate-100 focus-within:ring-2 focus-within:ring-slate-200 transition-all", data: { controller: "task-form" } do |f| %>
          <%= lucide_icon "circle", class: "w-5 h-5 text-slate-300 mr-3 shrink-0" %>
          <%= f.text_field :title, 
                placeholder: "Add a thought or task...", 
                class: "flex-1 bg-transparent border-none outline-none text-sm text-slate-900 placeholder:text-slate-400 font-medium min-w-0",
                data: { task_form_target: "input" } %>
          <button type="submit" 
                  class="w-10 h-10 ml-2 shrink-0 bg-slate-900 rounded-xl flex items-center justify-center text-white hover:bg-slate-800 transition-colors active:scale-95"
                  data-action="click->task-form#submit">
            <%= lucide_icon "plus", class: "w-5 h-5" %>
          </button>
        <% end %>
      </turbo-frame>

      <%# 5. Priority Tasks List %>
      <section>
        <div class="flex items-center justify-between px-1 mb-4">
          <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest">Priority Tasks</h3>
          <span class="text-xs text-slate-400 font-medium">Ordered by urgency</span>
        </div>
        
        <turbo-frame id="priority_tasks" class="space-y-3 block">
          <%= render partial: "tasks/task", collection: @priority_tasks %>
        </turbo-frame>
      </section>

      <%# 6. Completed Tasks List (Toggleable via Stimulus) %>
      <section class="pt-2">
        <button type="button" 
                class="flex items-center justify-between w-full px-1 mb-4 group" 
                data-action="click->tasks#toggleCompleted">
          <div class="flex items-center gap-2 text-slate-500 group-hover:text-slate-800 transition-colors">
            <%= lucide_icon "chevron-down", class: "w-[18px] h-[18px]" %>
            <h3 class="text-xs font-semibold uppercase tracking-widest">Completed</h3>
          </div>
          <span class="text-[11px] font-semibold bg-slate-200/60 text-slate-600 px-2.5 py-1 rounded-full tracking-wide">
            <%= @completed_tasks.count %> done
          </span>
        </button>
        
        <turbo-frame id="completed_tasks" class="space-y-3 block">
          <%= render partial: "tasks/completed_task", collection: @completed_tasks %>
        </turbo-frame>
      </section>

      <footer class="pt-8 pb-10 text-center px-6">
        <p class="text-[13px] text-slate-400 italic leading-relaxed font-serif">
          "Perfection is attained not when there is nothing more to add, but when there is nothing left to take away."
        </p>
      </footer>
    </main>

    <%# 7. Bottom Navigation %>
    <nav class="fixed bottom-0 w-full max-w-md bg-slate-50/90 backdrop-blur-xl border-t border-slate-200/50 pb-8 pt-3 z-50">
      <div class="flex justify-around items-center px-4">
        <a href="#" class="flex flex-col items-center justify-center min-w-[64px] gap-1 transition-colors text-slate-900">
          <%= lucide_icon "check-circle-2", class: "w-6 h-6" %>
          <span class="text-[10px] font-semibold tracking-wide uppercase">Tasks</span>
        </a>
        <a href="#" class="flex flex-col items-center justify-center min-w-[64px] gap-1 transition-colors text-slate-400 hover:text-slate-600">
          <%= lucide_icon "activity", class: "w-6 h-6" %>
          <span class="text-[10px] font-semibold tracking-wide uppercase">Activity</span>
        </a>
        <a href="#" class="flex flex-col items-center justify-center min-w-[64px] gap-1 transition-colors text-slate-400 hover:text-slate-600">
          <%= lucide_icon "file-text", class: "w-6 h-6" %>
          <span class="text-[10px] font-semibold tracking-wide uppercase">Notes</span>
        </a>
        <a href="#" class="flex flex-col items-center justify-center min-w-[64px] gap-1 transition-colors text-slate-400 hover:text-slate-600">
          <%= lucide_icon "user", class: "w-6 h-6" %>
          <span class="text-[10px] font-semibold tracking-wide uppercase">Profile</span>
        </a>
      </div>
    </nav>
  </div>
</div>