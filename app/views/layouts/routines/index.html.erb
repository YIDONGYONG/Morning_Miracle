<h1>루틴 목록</h1>

<%# <%= %> : 화면에 HTML 결과물(링크 버튼)을 '출력'합니다 %>
<%= link_to "새 루틴 만들기", new_routine_path, class: "text-indigo-600 hover:underline" %>

<hr class="my-4">

<%# <% %> : 화면에 출력하지 않고 조건문(로직)만 '실행'합니다 %>
<% if @routines.any? %>
  <div id="routines" class="space-y-2">
    <%# <%= %> : 파셜(_routine.html.erb)이 렌더링된 결과를 화면에 '출력'합니다 %>
    <%= render @routines %>
  </div>
<% else %>
  <p class="text-slate-500">등록된 루틴이 없습니다.</p>
<% end %>