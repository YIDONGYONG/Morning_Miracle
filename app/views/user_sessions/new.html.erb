<%# ログイン画面 %>
<div class="page">
  <%= render "shared/hero", title: t(".title") %>

  <main class="page-body max-w-md">
    <%= form_with url: login_path, class: "card space-y-4" do |f| %>
      <div>
        <%= f.label :email, t("helpers.label.email"), class: "field-label" %>
        <%= f.email_field :email, value: params[:email], autocomplete: "email", class: "field-input" %>
      </div>
      <div>
        <%= f.label :password, t("helpers.label.password"), class: "field-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "field-input" %>
      </div>
      <%= f.submit t(".login"), class: "btn btn-primary w-full" %>
      <div class="flex flex-wrap justify-between gap-x-4 gap-y-1 text-xs">
        <%= link_to t(".to_register_page"), new_user_path, class: "topnav-link" %>
        <%# パスワード再設定機能は未実装のためリンクのみ（実装時に差し替え） %>
        <%= link_to t(".password_forget"), "#", class: "topnav-link" %>
      </div>
    <% end %>
  </main>
</div>
