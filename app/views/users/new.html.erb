<%# ユーザー登録画面 %>
<div class="page">
  <%= render "shared/hero", title: t(".title") %>

  <main class="page-body max-w-md">
    <%= form_with model: @user, class: "card space-y-4" do |f| %>
      <% if @user.errors.any? %>
        <ul class="field-error list-inside list-disc space-y-1">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>

      <%# 項目の定義を配列にまとめ、同じマークアップの繰り返しを避ける %>
      <% [[:last_name, :text_field], [:first_name, :text_field], [:email, :email_field],
          [:password, :password_field], [:password_confirmation, :password_field]].each do |attr, type| %>
        <div>
          <%= f.label attr, class: "field-label" %>
          <%= f.public_send(type, attr, class: "field-input") %>
        </div>
      <% end %>

      <%= f.submit class: "btn btn-primary w-full" %>
      <div class="text-center text-sm">
        <%= link_to t(".to_login_page"), login_path, class: "topnav-link" %>
      </div>
    <% end %>
  </main>
</div>
