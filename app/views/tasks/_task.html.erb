<div id="<%= dom_id(task) %>" class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex items-start gap-4 group hover:border-slate-300 transition-all cursor-pointer">
  
  <%# 완료 처리 버튼 (Ajax/Turbo 요청) %>
  <%= button_to complete_task_path(task), method: :patch, class: "mt-0.5 shrink-0", data: { action: "click->tasks#complete" } do %>
    <%= lucide_icon "circle", class: "w-[22px] h-[22px] text-slate-300 group-hover:text-slate-400 transition-colors" %>
  <% end %>
  
  <div class="flex-1 min-w-0">
    <p class="text-[14px] font-medium text-slate-900 truncate"><%= task.title %></p>
    <div class="flex items-center gap-3 mt-2.5">
      <span class="text-[11px] font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 tracking-wide">
        <%= task.tag || "Inbox" %>
      </span>
      <span class="text-[11px] font-medium text-slate-500 flex items-center gap-1.5">
        <%= lucide_icon "clock", class: "w-3 h-3" %>
        <%= task.due_time || "Today" %>
      </span>
    </div>
  </div>

  <button type="button" class="shrink-0 opacity-40 group-hover:opacity-100 hover:text-slate-900 transition-opacity">
    <%= lucide_icon "more-vertical", class: "w-[18px] h-[18px] text-slate-400" %>
  </button>
</div>