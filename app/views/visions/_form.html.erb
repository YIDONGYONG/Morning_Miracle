<%# 新規・編集で共用するフォーム（保存処理は VisionsController 側） %>
<%= form_with(model: vision, class: "card space-y-4") do |form| %>
  <% if vision.errors.any? %>
    <div class="field-error space-y-1">
      <p><%= vision.errors.count %>件のエラーがあるため保存できません</p>
      <ul class="list-inside list-disc text-xs">
        <% vision.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "タイトル", class: "field-label" %>
    <%= form.text_field :title, placeholder: "ビジョンのタイトルを入力してください...", class: "field-input" %>
  </div>

  <div>
    <%= form.label :content, "詳細", class: "field-label" %>
    <%= form.text_area :content, rows: 4, placeholder: "このビジョンについて詳しく書いてみましょう...", class: "field-input resize-none" %>
  </div>

  <%= form.submit "保存する", class: "btn btn-primary w-full" %>
<% end %>
